{
    "name": "corpus/loggers",
    "description": "Composable PSR-3 loggers for filtering, routing, adding context, and writing logs to streams.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "psr-3",
        "logger",
        "log",
        "logging",
        "logging utilities",
        "log filtering",
        "log routing",
        "log context",
        "stream logging",
        "memory logging"
    ],
    "require": {
        "psr/log": "^1 || ^2 || ^3",
        "php": "^8.1"
    },
    "require-dev": {
        "corpus/coding-standard": "^0.10.0",
        "corpus/php-cs-fixer-config": "^0.1.0",
        "corpus/recursive-require": "^1.2",
        "donatj/drop": "^1.1",
        "donatj/mddoc": "=0.14.1",
        "friendsofphp/php-cs-fixer": "=3.95.27",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "rawr/phpunit-data-provider": "^3.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Corpus\\Loggers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corpus\\Loggers\\": "test/"
        }
    },
    "authors": [
        {
            "name": "Jesse Donat",
            "email": "donatj@gmail.com"
        }
    ],
    "provide": {
        "psr/log-implementation": "1.0|2.0|3.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
